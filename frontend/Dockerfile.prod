# syntax=docker/dockerfile:1

# --------------------------------------------------------------------------
# Étage 1 — build du SPA
# --------------------------------------------------------------------------
FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS builder

WORKDIR /app

# `npm ci` et non `npm install` : l'installation est déduite du lockfile, donc
# reproductible. `npm install` peut réécrire le lockfile et tirer des versions
# différentes d'un build à l'autre.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build


# --------------------------------------------------------------------------
# Étage 2 — service des fichiers statiques
#
# Le SPA est un ensemble de fichiers statiques ; le servir par `npm run dev`
# (serveur de développement Vite) en production, c'est exposer un rechargeur
# à chaud, sans compression, sans cache et mono-thread.
# --------------------------------------------------------------------------
# Branche stable (numero pair) : 1.27 n'etait plus maintenue et restait sur
# une Alpine dont l'OpenSSL avait une faille CRITICAL corrigee depuis.
FROM nginx:1.31-alpine@sha256:1ed1b0e1d7652937d6cbdaf4018c7b6fc009a7dd6c3047351e2eddda745de43f AS runtime

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

# nginx:alpine tourne déjà en non-root pour les workers, mais le port 80
# exigerait des privilèges : on écoute sur 8080 et le maître tourne en nginx.
# Les motifs portent sur la directive et non sur sa valeur : l'image amont a
# déjà déplacé le pid de /var/run vers /run sans prévenir, et un sed qui ne
# trouve rien ne signale rien. Le grep final fait échouer le build dans ce cas.
RUN sed -i 's/^user[[:space:]].*;/# user directive removed: running unprivileged/' /etc/nginx/nginx.conf \
    && sed -i 's|^pid[[:space:]].*;|pid /tmp/nginx.pid;|' /etc/nginx/nginx.conf \
    && grep -q '^pid /tmp/nginx.pid;' /etc/nginx/nginx.conf \
    && ! grep -q '^user[[:space:]]' /etc/nginx/nginx.conf \
    && chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx

USER nginx

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q --spider http://localhost:8080/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
