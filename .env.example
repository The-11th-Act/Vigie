# Copier vers .env et completer. Ne jamais committer le vrai .env.
#
# Ce fichier couvre le developpement ET la production. Les variables marquees
# [PROD] n'ont aucune valeur par defaut dans docker-compose.prod.yml : le
# demarrage echoue si elles manquent, plutot que de lancer la plateforme avec
# un secret connu de tous.

# ---------------------------------------------------------------------------
# Obligatoire partout
# ---------------------------------------------------------------------------

# Generer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Au moins 32 caracteres. L'application refuse de demarrer en production si
# cette valeur est une valeur par defaut connue ou trop courte.
SECRET_KEY=

# Identifiant de SECRET_KEY, inscrit dans chaque token (en-tete "kid").
# Rotation sans deconnecter personne : docs/EXPLOITATION.md.
SECRET_KEY_ID=k1
# Anciennes cles, par identifiant, encore acceptees pour verifier les
# tokens qu'elles ont signes. Au format JSON, par exemple :
#   PREVIOUS_SECRET_KEYS={"k1": "<ancienne cle>"}
# A vider une fois REFRESH_TOKEN_EXPIRE_DAYS ecoules.
PREVIOUS_SECRET_KEYS=

# Attribut Secure des cookies de session du navigateur. Vide : actif en
# production, inactif sinon (un cookie Secure n'est jamais envoye en HTTP).
# Laisser actif derriere le terminateur TLS de production.
AUTH_COOKIE_SECURE=

# development | staging | production
# En production, la documentation interactive est desactivee et un SECRET_KEY
# faible est fatal.
ENVIRONMENT=development

DATABASE_URL=postgresql://vigie_user:vigie_password@localhost:5432/vigie
REDIS_URL=redis://localhost:6379/0

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Limitation des tentatives de connexion. Les echecs sont comptes par IP source
# et par compte ; des que LOGIN_MAX_ATTEMPTS est atteint dans la fenetre
# LOGIN_WINDOW_SECONDS, la portee concernee est verrouillee pendant
# LOGIN_LOCKOUT_SECONDS. Adosse a Redis ; si Redis tombe, le comptage se replie
# sur chaque process (non partage entre eux).
RATE_LIMIT_ENABLED=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900

# Taille maximale d'un fichier de scan accepte, en octets (50 Mo par defaut).
# Doit rester <= client_max_body_size dans frontend/nginx.conf.
MAX_SCAN_UPLOAD_BYTES=52428800

# Repertoire ou les uploads attendent d'etre ingeres par le worker. Doit etre
# partage entre l'API et le worker Celery (un volume sous docker-compose).
SCAN_UPLOAD_DIR=/var/lib/vigie/scans

# Heure (UTC) du recalcul quotidien des scores du backlog ouvert, lance par le
# service beat. La penalite de retard croit avec le temps : sans ce passage, un
# finding en retard sur un hote que personne ne rescanne garde son rang d'origine.
RESCORE_HOUR_UTC=2

# Duree d'une acceptation de risque sans date donnee, et duree maximale. Une
# acceptation echue est rouverte par le passage quotidien, avec une trace dans
# le journal d'audit ; un CVE qui entre dans KEV rouvre aussi les siennes.
RISK_ACCEPTANCE_DEFAULT_DAYS=90
RISK_ACCEPTANCE_MAX_DAYS=365

# Sous-reseaux exposes a Internet (DMZ, plages publiques), au format JSON. Un
# asset decouvert dans l'un d'eux nait "expose", ce qui multiplie son risque
# par 1.2 ; un choix fait ensuite a la main n'est jamais ecrase.
# INTERNET_FACING_SUBNETS=["203.0.113.0/24"]

# Equipe chargee de corriger ce qui est trouve dans un sous-reseau, au
# format JSON ; le prefixe le plus specifique l'emporte. Elle decide a quelle
# equipe part un ticket de remediation. Appliquee aux assets sans equipe.
# OWNER_TEAM_RULES={"10.0.0.0/8":"Infrastructure","10.20.0.0/16":"Workplace"}

# Environnement (production, recette...) par sous-reseau, meme principe.
# Le type d'asset (serveur, poste, reseau) se deduit, lui, de l'OS.
# ENVIRONMENT_RULES={"10.0.0.0/8":"production","10.99.0.0/16":"staging"}

LOG_LEVEL=INFO
# text (terminal) ou json (collecteur de logs : une ligne = un document,
# request_id compris). En production, json.
LOG_FORMAT=text

# Optionnel : si les trois sont renseignes, l'application cree (ou promeut) ce
# compte en administrateur au demarrage. Laisser vide pour ne pas bootstrapper
# et gerer les roles via PATCH /api/v1/users/{id}/role.
#
# En production, prefere un lancement ponctuel plutot qu'une variable
# permanente du service : un mot de passe administrateur dans l'environnement
# d'un conteneur qui tourne en permanence est une exposition inutile.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Contexte de menace : CISA KEV et FIRST EPSS (optionnel)
#
# A true, le service beat telecharge chaque jour le catalogue KEV (CVE exploites
# dans la nature) et le fichier EPSS (probabilite d'exploitation a 30 jours),
# puis recalcule les findings concernes. Sans acces Internet sortant, laisser a
# false et importer les fichiers a la main :
#   python -m scripts.import_threat_intel --kev kev.json --epss epss.csv.gz
# Un proxy se configure par HTTPS_PROXY / NO_PROXY, une CA interne par
# REQUESTS_CA_BUNDLE.
# ---------------------------------------------------------------------------
THREAT_INTEL_ENABLED=false
THREAT_INTEL_REFRESH_HOUR_UTC=6
# THREAT_INTEL_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
# THREAT_INTEL_EPSS_URL=https://epss.empiricalsecurity.com/epss_scores-current.csv.gz
# Jours laisses pour corriger un CVE KEV, depuis sa detection ou son inscription
# (la plus tardive). Ne fait que raccourcir une echeance. 0 desactive.
KEV_SLA_DAYS=14

# ---------------------------------------------------------------------------
# CrowdStrike Falcon Spotlight (optionnel)
#
# Renseigner les identifiants et passer CROWDSTRIKE_SYNC_ENABLED a true pour
# que le service beat importe periodiquement les findings ouverts. L'URL de
# base depend de la region du tenant (api.eu-1.crowdstrike.com,
# api.us-2.crowdstrike.com, ...).
# ---------------------------------------------------------------------------
CROWDSTRIKE_CLIENT_ID=
CROWDSTRIKE_CLIENT_SECRET=
CROWDSTRIKE_BASE_URL=https://api.crowdstrike.com
CROWDSTRIKE_SYNC_ENABLED=false
CROWDSTRIKE_SYNC_INTERVAL_MINUTES=360

# ---------------------------------------------------------------------------
# Base de donnees (utilise par docker-compose pour le conteneur PostgreSQL)
# ---------------------------------------------------------------------------
POSTGRES_USER=vigie_user
POSTGRES_PASSWORD=vigie_password
POSTGRES_DB=vigie

# ---------------------------------------------------------------------------
# [PROD] Requis uniquement par docker-compose.prod.yml
#
# Lancement :
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
# ---------------------------------------------------------------------------

# Les secrets de production ne sont PAS ici : SECRET_KEY, les mots de passe
# PostgreSQL et Redis et PREVIOUS_SECRET_KEYS sont des fichiers du repertoire
# secrets/ (Docker secrets), voir README "Running in production". Une valeur
# laissee dans ce fichier est ignoree par la surcouche de production.
# Repertoire des secrets, si ce n'est pas ./secrets :
# VIGIE_SECRETS_DIR=/etc/vigie/secrets

# Nombre de process uvicorn. L'application est synchrone cote base : la
# concurrence vient des process, pas de l'async. Regle de depart : 2 x coeurs.
UVICORN_WORKERS=4

# Concurrence Celery. Chaque worker charge un scan en memoire pendant le
# parsing : monter cette valeur augmente le pic memoire d'autant.
CELERY_CONCURRENCY=4

# Sauvegardes (service backup, voir docs/SAUVEGARDE.md). Cle PUBLIQUE age : le
# serveur chiffre avec, seule la cle privee, gardee hors de la plateforme,
# dechiffre. Generer la paire sur un poste d'administration :
#   age-keygen -o vigie-backup.key   (affiche la cle publique age1...)
# Sans cle, le service refuse d'ecrire une sauvegarde en clair et devient
# unhealthy ; BACKUP_ALLOW_UNENCRYPTED=true leve ce refus.
BACKUP_AGE_RECIPIENT=
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
# Volume nomme par defaut. Un chemin (ex. /mnt/nas/vigie) place les sauvegardes
# sur un autre stockage que la base ; il doit appartenir a l'uid 70 (postgres).
# BACKUP_VOLUME=/mnt/nas/vigie

# Interface et port d'ecoute du frontend. Par defaut 127.0.0.1 : la plateforme
# n'est pas exposee directement, on la place derriere un terminaison TLS
# (reverse proxy en amont, ingress, ou tunnel).
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080
