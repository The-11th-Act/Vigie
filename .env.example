# Copy to .env and fill in. Never commit the real .env.

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters. The app refuses to start in production if
# this is a known default or too short.
SECRET_KEY=

# development | staging | production
# In production the API docs are disabled and a weak SECRET_KEY is fatal.
ENVIRONMENT=development

DATABASE_URL=postgresql://tvm_user:tvm_password@localhost:5432/tvm_platform
REDIS_URL=redis://localhost:6379/0

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Login throttling. Failures are counted per source IP and per account; once
# LOGIN_MAX_ATTEMPTS is reached within LOGIN_WINDOW_SECONDS, that scope is
# locked for LOGIN_LOCKOUT_SECONDS. Backed by Redis; with Redis down the limit
# falls back to per-process counting.
RATE_LIMIT_ENABLED=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900

# Maximum accepted scan upload, in bytes (default 50 MB).
MAX_SCAN_UPLOAD_BYTES=52428800

# Where uploads are staged before the worker ingests them. Must be a directory
# shared between the API and the Celery worker (a volume under docker-compose).
SCAN_UPLOAD_DIR=/var/lib/vigie/scans

LOG_LEVEL=INFO

# Optional: if all three are set, the app creates (or promotes) this account
# to admin on startup. Leave blank to skip bootstrap and manage roles via
# PATCH /api/v1/users/{id}/role instead.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Used by docker-compose for the Postgres container.
POSTGRES_USER=tvm_user
POSTGRES_PASSWORD=tvm_password
POSTGRES_DB=tvm_platform
